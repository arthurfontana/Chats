# Copie este arquivo para ".env" (na pasta backend/) e preencha com sua chave real.
# NUNCA faça commit do arquivo .env.

NVIDIA_API_KEY=sua_chave_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GLM_MODEL=meta/llama-3.3-70b-instruct
GLM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Chave da Google Cloud com Geocoding API e Street View Static API habilitadas.
GOOGLE_MAPS_API_KEY=sua_chave_google_aqui
