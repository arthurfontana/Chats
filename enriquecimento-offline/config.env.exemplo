# Copie este arquivo para "config.env" (mesma pasta) e preencha os valores.
# NUNCA compartilhe o config.env preenchido nem faça commit dele em nenhum repositório.

# --------------------------------------------------------------------------
# MODO 1 (padrão): chamadas diretas ao Google Maps e ao modelo de visão.
# Exige que a rede da máquina libere maps.googleapis.com e o VISION_BASE_URL.
# Se a rede corporativa bloquear esses domínios, use o MODO 2 abaixo.
# --------------------------------------------------------------------------

GOOGLE_MAPS_API_KEY=coloque_sua_chave_google_maps_aqui

# Endpoint e modelo de visao compativel com a API da OpenAI.
# Pode ser a OpenAI mesma, o Azure OpenAI, ou um provedor interno da empresa.
VISION_API_KEY=coloque_sua_chave_do_modelo_de_visao_aqui
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o-mini

# --------------------------------------------------------------------------
# MODO 2: proxy via Vercel — use quando a rede interna bloquear
# maps.googleapis.com / api.openai.com mas liberar seu próprio domínio
# *.vercel.app. Preencha VERCEL_PROXY_URL com a URL do deploy deste mesmo
# repositório (o main.py já expõe /api/storefront-batch-addresses).
# Nesse modo GOOGLE_MAPS_API_KEY e VISION_API_KEY acima NÃO são necessárias
# na máquina local — as chaves ficam só nas variáveis de ambiente do Vercel.
# --------------------------------------------------------------------------

VERCEL_PROXY_URL=

# Quantos enderecos processar em paralelo (5 e um valor seguro para nao
# estourar limites de taxa das APIs).
CONCURRENCY=5
